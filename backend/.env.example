# Server Port
PORT=3001
NODE_ENV=development

# Database WAMPServer Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=checklist_sarfas_hsse
DB_USER=root
DB_PASSWORD=

# Security & Authentication (Gunakan secret acak yang kuat minimal 32 karakter)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (Pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:8000

# Demo Mode (Hanya aktifkan saat presentasi/evaluasi lokal, WAJIB false pada produksi)
DEMO_MODE=true
