{
  "name": "checklist-sarfas-hsse-backend",
  "version": "1.0.0",
  "description": "REST API Backend for Checklist Sarfas HSSE - Fuel Terminal Maos",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex --knexfile src/database/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile src/database/knexfile.js migrate:rollback",
    "seed": "knex --knexfile src/database/knexfile.js seed:run",
    "test": "node src/test-api.js"
  },
  "keywords": [
    "pertamina",
    "hsse",
    "sarfas",
    "inspection",
    "express",
    "knex",
    "mysql"
  ],
  "author": "Pertamina HSSE Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.5"
  }
}
